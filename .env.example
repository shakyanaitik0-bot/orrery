# --- Database ---
# Postgres is the target. SQLite is the default only so a fresh clone runs.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/orrery
DATABASE_URL=sqlite+aiosqlite:///./orrery.db

# --- AWS Bedrock ---
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-20260115-v1:0
BEDROCK_SMALL_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Leave unset in deployment so boto3 uses the task or instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fail loudly instead of falling back to the offline stub. Set true in production.
LLM_REQUIRED=false

ENVIRONMENT=development
